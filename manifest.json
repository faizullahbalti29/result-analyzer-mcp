{
    "manifest_version": "0.2",
    "name": "fbise-result-mcp",
    "version": "1.0.0",
    "description": "A result analyzer for FBiSE ninth and tenth class results.",
    "author": {
        "name": "Faizullah",
        "email": "faiz@knowpakistan.org"
    },
    "server": {
        "type": "node",
        "entry_point": "dist/index.js",
        "mcp_config": {
            "command": "node",
            "args": [
                "${__dirname}/dist/index.js"
            ],
            "env": {
                "MONGODB_URI": "${user_config.mongodb_uri}",
                "MONGODB_DATABASE": "${user_config.mongodb_database}"
            }
        }
    },
    "user_config": {
        "mongodb_uri": {
            "type": "string",
            "title": "MongoDB URI",
            "description": "MongoDB connection URI for the FBiSE result database.",
            "sensitive": true,
            "required": true
        },
        "mongodb_database": {
            "type": "string",
            "title": "MongoDB Database",
            "description": "MongoDB database containing the ninth and tenth class results.",
            "default": "my-expense-manager",
            "required": true
        }
    },
    "license": "MIT"
}